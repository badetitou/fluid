# Shared local development environment variables.
# Copy to .env and adjust as needed. Each package also documents the vars it reads.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://fluid:fluid@localhost:5432/fluid?schema=public"

# Secrets of configured sources: 32 bytes as 64 hex chars or base64 (openssl rand -base64 32).
# Required when DATABASE_URL is set; generated into <data dir>/secret.key otherwise.
# FLUID_SECRET_KEY=

# Refuse loopback and private networks (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7) for
# outbound source calls, for deployments exposed to untrusted users. Link-local and cloud-metadata
# addresses are always refused.
# FLUID_BLOCK_PRIVATE_HOSTS=1

# Public address of fluid; the OAuth redirect URI is <FLUID_PUBLIC_URL>/api/oauth/callback.
# FLUID_PUBLIC_URL=https://fluid.example.com
