// fluid BFF — persistence for dashboard views and user preferences.
// Uses a custom client output (src/generated/prisma) so this client never
// collides with another Prisma client in the pnpm store.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A persisted dashboard view (the JSON ViewSpec plus a little metadata).
model View {
  id        String   @id @default(cuid())
  concept   String
  title     String
  spec      Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([concept])
}

/// A GraphQL source the BFF can call on behalf of the browser. `secret` is AES-256-GCM
/// ciphertext (never returned by the API).
model SourceConfig {
  id                String           @id @default(cuid())
  name              String
  url               String
  authKind          String           @default("none")
  headerName        String?
  secret            String?
  /// OAuth (authKind "oauth"): issuer, client id, encrypted client secret, space-separated scopes, RFC 8707 resource.
  oauthIssuer       String?
  oauthClientId     String?
  oauthClientSecret String?
  oauthScopes       String?
  oauthResource     String?
  /// Bumped by sign-out, auth reconfiguration and delete; token writes only land if it is unchanged.
  authGeneration    Int              @default(0)
  /// Whether view actions (mutations) may run on this source from the BFF (MCP hosts). Off by default.
  allowWrites       Boolean          @default(false)
  credential        OAuthCredential?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

/// OAuth tokens of a source (one per source until there are several users). Tokens are
/// AES-256-GCM ciphertext (never returned by the API).
model OAuthCredential {
  sourceId     String       @id
  source       SourceConfig @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

/// A simple key/value store for app preferences (mono-user demo).
model Preference {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// One run of a view action from an MCP host: what ran, with what, and what came back.
model ActionLog {
  id        String   @id @default(cuid())
  viewId    String
  action    String
  sourceId  String
  /// The resolved variables sent with the mutation.
  variables Json
  ok        Boolean
  /// The answer, cut when large (see views/action-service.ts).
  result    Json
  createdAt DateTime @default(now())

  @@index([viewId])
}
