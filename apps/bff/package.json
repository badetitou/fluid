{
  "name": "@fluid/bff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fluid BFF: persists dashboard views and preferences, proxies the LLM (later).",
  "license": "MIT",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
