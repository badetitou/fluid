# Fluid BFF configuration
# PostgreSQL connection. Uses a dedicated schema (fluid_app) so the BFF's tables
# and migration history stay isolated from anything else in the database.
DATABASE_URL="postgresql://fluid:fluid@localhost:5432/fluid?schema=fluid_app"

# Key encrypting source secrets (API keys, tokens): 32 bytes as 64 hex chars or base64
# (`openssl rand -base64 32`). Required to store secrets with DATABASE_URL. Without a database
# URL it is generated once into <dataDir>/secret.key. Losing it makes stored secrets unreadable.
# FLUID_SECRET_KEY=

# HTTP port the BFF listens on.
PORT=4001

# ---------------------------------------------------------------------------
# LLM view generation (Phase 4). All optional — with nothing set, the BFF uses
# the offline `mock` provider so the assistant works out of the box.
# ---------------------------------------------------------------------------
# Default provider: openai | ollama | claude-code | mock. If unset, defaults to `openai` when
# OPENAI_API_KEY is present, otherwise `mock`. Clients may override per request.
# LLM_PROVIDER=mock

# OpenAI (or any OpenAI-compatible API).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama via its OpenAI-compatible endpoint.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# Claude via the locally installed Claude Code CLI (`claude -p`), authenticated
# with the CLI's own login (e.g. a Claude Pro/Max subscription) — no API key.
# Only works when the BFF runs on a machine where `claude` is installed and
# logged in (local dev), not in the container images. ANTHROPIC_API_KEY is
# removed from the CLI's environment so it always uses that login.
# CLAUDE_CODE_BIN=claude
# CLAUDE_CODE_MODEL=sonnet          # alias (sonnet | opus | haiku) or full model id
# CLAUDE_CODE_TIMEOUT_MS=240000

# ---------------------------------------------------------------------------
# GitHub source: explore a public GitHub repository with badetitou/Model's
# `model-graphql` (cargo install model-graphql --version 0.3.0 --locked).
# See docs/guides/github-source.md. Enabled in the all-in-one Docker image.
# ---------------------------------------------------------------------------
# FLUID_REPOS_ENABLED=false
# FLUID_MODEL_GRAPHQL_BIN=model-graphql   # path, if not on PATH
# FLUID_REPOS_DIR=                        # default <data dir>/repos
# FLUID_REPOS_MAX_RUNNING=3               # running model-graphql servers (LRU)
# FLUID_REPOS_MAX_BYTES=209715200         # download size limit (200 MiB)
