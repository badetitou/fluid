# @fluid/frontend environment
# GraphQL URL pre-filled on the connection screen (the demo bank API).
VITE_DEFAULT_GRAPHQL_URL="http://localhost:4000/graphql"

# Fluid BFF base URL (used from Phase 3 onward for view persistence + LLM proxy).
VITE_BFF_URL="http://localhost:4001"

# Hosts the "image" format may load pictures from (comma-separated, "*.domain" for subdomains).
# Empty = any https host; images are always loaded only after a user click.
VITE_IMAGE_HOSTS="rickandmortyapi.com"
