{
  "name": "@fluid/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fluid frontend: connect to a GraphQL source, explore concepts, render dashboard views.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/plots": "^2.6.8",
    "@fluid/shared": "workspace:*",
    "@urql/core": "^6.0.3",
    "antd": "^6.6.7",
    "graphql": "^17.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "urql": "^5.0.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
