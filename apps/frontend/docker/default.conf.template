# Fluid frontend nginx config (rendered from env vars by the nginx image's
# envsubst template step). Undefined tokens like $uri/$host are left untouched;
# only ${FRONTEND_PORT}/${BFF_UPSTREAM} are substituted.
server {
    listen       ${FRONTEND_PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # SPA shell and runtime config must never be cached.
    location = /config.js {
        add_header Cache-Control "no-store";
    }
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Fluid BFF (view persistence, preferences, LLM proxy).
    location /api/ {
        proxy_pass ${BFF_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else is the single-page app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
