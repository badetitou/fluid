data: {"spec":{"version":1,"id":"gen-94d9592f","concept":"Character","title":"Character profile","description":"Profile of the character and the episodes they appear in.","queries":{"character":{"query":"query($id: ID!) { character(id: $id) { id name status species type gender image created origin { id name } location { id name } episode { id name episode air_date } } }"}},"widgets":[{"type":"descriptions","id":"profile","title":"Profile","span":16,"data":{"query":"character","path":"character"},"items":[{"label":"Image","key":"image","format":"image"},{"label":"Name","key":"name"},{"label":"Status","key":"status","format":"tag"},{"label":"Species","key":"species","format":"tag"},{"label":"Type","key":"type"},{"label":"Gender","key":"gender","format":"tag"},{"label":"Origin","key":"origin.name","linkTo":{"concept":"Location","idField":"origin.id"}},{"label":"Last location","key":"location.name","linkTo":{"concept":"Location","idField":"location.id"}},{"label":"Created","key":"created","format":"datetime"}],"columns":2},{"type":"statistic","id":"episode-count","title":"Episodes","span":8,"data":{"query":"character","path":"character.episode"},"value":{"op":"count"}},{"type":"table","id":"episodes","title":"Episodes","span":24,"data":{"query":"character","path":"character.episode","transform":{"sort":{"by":"episode","dir":"asc"}}},"columns":[{"key":"name","title":"Name","linkTo":{"concept":"Episode","idField":"id"}},{"key":"episode","title":"Episode code"},{"key":"air_date","title":"Air date"}],"pageSize":10}],"scope":"detail"},"provider":"claude-code","model":"sonnet","reasoning":["Fiche profil (descriptions) avec l'image, le statut, l'espèce, le genre et le type, ainsi que l'origine et la dernière localisation en liens vers Location.","Le champ \"episode\" est de type inconnu : je suppose que ses éléments exposent id, name, episode et air_date, comme demandé.","Tableau des épisodes (nom, code, date de diffusion) trié sur le code de l'épisode, avec lien vers l'épisode sur le nom.","Une statistique du nombre d'épisodes en en-tête pour situer rapidement le personnage."]}

