data: {"spec":{"version":1,"id":"gen-94d9592f","concept":"Character","title":"Character profile","description":"Profile of the character and the episodes they appear in.","queries":{"character":{"query":"query($id: ID!) { character(id: $id) { id name status species type gender image created origin { id name } location { id name } episode { id name episode air_date } } }"}},"widgets":[{"type":"descriptions","id":"profile","title":"Profile","span":16,"data":{"query":"character","path":"character"},"items":[{"label":"Image","key":"image","format":"image"},{"label":"Name","key":"name"},{"label":"Status","key":"status","format":"tag"},{"label":"Species","key":"species","format":"tag"},{"label":"Type","key":"type"},{"label":"Gender","key":"gender","format":"tag"},{"label":"Origin","key":"origin.name","linkTo":{"concept":"Location","idField":"origin.id"}},{"label":"Last location","key":"location.name","linkTo":{"concept":"Location","idField":"location.id"}},{"label":"Created","key":"created","format":"datetime"}],"columns":2},{"type":"statistic","id":"episode-count","title":"Appearances","span":8,"data":{"query":"character","path":"character.episode"},"value":{"op":"count"}},{"type":"table","id":"episodes","title":"Episodes","span":24,"data":{"query":"character","path":"character.episode","transform":{"sort":{"by":"episode","dir":"asc"}}},"columns":[{"key":"name","title":"Name","linkTo":{"concept":"Episode","idField":"id"}},{"key":"episode","title":"Episode code"},{"key":"air_date","title":"Air date"}],"pageSize":10}],"scope":"detail"},"provider":"claude-code","model":"sonnet","reasoning":["A profile card (descriptions) with the image, status, species, gender and type, plus the origin and last location as links to Location.","The \"episode\" field has an unknown type: I assume its items expose id, name, episode and air_date, as requested.","A table of the episodes (name, code, air date) sorted by episode code, with the name linking to the episode.","A statistic with the number of episodes at the top, to place the character at a glance."]}

