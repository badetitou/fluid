{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/badetitou/fluid/docs/architecture/open-views.schema.json",
  "title": "fluid Open Views, protocol v1",
  "$defs": {
    "ViewRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id"
      ]
    },
    "ViewItem": {
      "type": "object",
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "ref": {
                "$ref": "#/$defs/ViewRef"
              }
            },
            "required": [
              "text"
            ]
          }
        },
        "ref": {
          "$ref": "#/$defs/ViewRef"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewItem"
          }
        },
        "hasChildren": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "cells"
      ]
    },
    "ViewNode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ViewItem"
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lazy": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "columnedList"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "title"
                ]
              }
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ViewItem"
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lazy": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "columns",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tree"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "title"
                ]
              }
            },
            "roots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ViewItem"
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lazy": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "roots"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "highlights": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "start",
                  "end"
                ]
              }
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "svg"
            },
            "svg": {
              "type": "string"
            },
            "hotspots": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ref": {
                    "$ref": "#/$defs/ViewRef"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                },
                "required": [
                  "ref",
                  "x",
                  "y",
                  "width",
                  "height"
                ]
              }
            }
          },
          "required": [
            "kind",
            "svg"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "label"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "composite"
            },
            "direction": {
              "type": "string",
              "enum": [
                "row",
                "column"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ViewNode"
              }
            }
          },
          "required": [
            "kind",
            "direction",
            "children"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tabs"
            },
            "tabs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "node": {
                    "$ref": "#/$defs/ViewNode"
                  }
                },
                "required": [
                  "title",
                  "node"
                ]
              }
            },
            "selected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "tabs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "diff"
            },
            "before": {
              "type": "string"
            },
            "after": {
              "type": "string"
            },
            "beforeLabel": {
              "type": "string"
            },
            "afterLabel": {
              "type": "string"
            },
            "language": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "before",
            "after"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "forward"
            },
            "ref": {
              "$ref": "#/$defs/ViewRef"
            },
            "view": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "ref"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unsupported"
            },
            "type": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "type"
          ]
        }
      ]
    },
    "Discovery": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "const": "fluid-views"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "default": {},
          "type": "object",
          "properties": {
            "actions": {
              "type": "boolean"
            },
            "evaluate": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "protocol",
        "version",
        "name"
      ]
    },
    "ObjectViewsResponse": {
      "type": "object",
      "properties": {
        "object": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "priority": {
                "type": "number"
              }
            },
            "required": [
              "key",
              "title",
              "priority"
            ]
          }
        }
      },
      "required": [
        "object",
        "views"
      ]
    },
    "ViewResponse": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "priority": {
          "type": "number"
        },
        "view": {
          "$ref": "#/$defs/ViewNode"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "confirm": {
                "type": [
                  "boolean",
                  "string"
                ]
              }
            },
            "required": [
              "id",
              "label"
            ]
          }
        }
      },
      "required": [
        "key",
        "title",
        "priority",
        "view"
      ]
    },
    "ViewItemsResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewItem"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "items"
      ]
    },
    "ViewActionResult": {
      "type": "object",
      "properties": {
        "refresh": {
          "type": "boolean"
        },
        "ref": {
          "$ref": "#/$defs/ViewRef"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "EvaluationRequest": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ]
    },
    "Evaluation": {
      "type": "object",
      "properties": {
        "display": {
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/ViewRef"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "ref": {
                "$ref": "#/$defs/ViewRef"
              }
            },
            "required": [
              "text"
            ]
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "display"
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ]
    }
  }
}
