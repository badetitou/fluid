{
  "name": "fluid",
  "version": "0.0.0",
  "private": true,
  "description": "Fluid — a Smalltalk-inspector-inspired web UI: explore and shape your GraphQL data through reusable, LLM-generated dashboard views.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "frontend": "pnpm --filter @fluid/frontend"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
